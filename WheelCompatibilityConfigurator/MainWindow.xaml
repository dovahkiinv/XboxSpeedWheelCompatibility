<Window x:Class="WheelCompatibilityConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WheelCompatibilityConfigurator"
        mc:Ignorable="d"
        Title="Xbox Wheel Compatibility" Height="640" Width="440"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="ButtonDot" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#B0B0B0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="ButtonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#444" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="No wheel detected"
               x:Name="ServiceStatusIndicator"
               HorizontalAlignment="Center"
               FontSize="14"
               FontWeight="SemiBold" />

        <Border Grid.Row="1"
                x:Name="InjectionStatusBorder"
                CornerRadius="3"
                Padding="6,3"
                Margin="0,2,0,4"
                Background="#FFF8E1"
                BorderBrush="#E6C766"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="InjectionStatusText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="#6B5400" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Steering sensitivity" />
            <Label Grid.Column="1" x:Name="SensitivityValueLabel" Content="1.00" MinWidth="40" HorizontalContentAlignment="Right" />
        </Grid>

        <Slider Grid.Row="3"
                x:Name="SensitivitySlider"
                Minimum="0.1"
                Maximum="3.0"
                Value="1.0"
                TickFrequency="0.1"
                IsSnapToTickEnabled="False"
                SmallChange="0.05"
                LargeChange="0.25"
                ValueChanged="SensitivitySlider_ValueChanged"
                Margin="0,2,0,4" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="1.00 = linear. Below 1 = gentler near center. Above 1 = twitchier."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="ResetButton" Content="Reset" Padding="8,3" Click="ResetButton_Click" />
        </Grid>

        <Separator Grid.Row="5" Margin="0,10,0,6" />

        <Label Grid.Row="6" Content="Live input tester" FontWeight="SemiBold" Padding="0" />

        <StackPanel Grid.Row="7" Margin="0,4,0,0">
            <!-- Two steering wheel icons: raw input and post-sensitivity game output -->
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Wheel input" HorizontalAlignment="Center" FontSize="11" Foreground="#444" />
                    <Grid Width="100" Height="100" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,2">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="WheelInputRotation" Angle="0" />
                        </Grid.RenderTransform>
                        <Canvas Width="100" Height="100">
                            <Ellipse Canvas.Left="4" Canvas.Top="4" Width="92" Height="92" Stroke="#333" StrokeThickness="6" Fill="Transparent" />
                            <Line X1="50" Y1="50" X2="50" Y2="10" Stroke="#333" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="50" Y1="50" X2="16" Y2="70" Stroke="#333" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="50" Y1="50" X2="84" Y2="70" Stroke="#333" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="38" Canvas.Top="38" Width="24" Height="24" Fill="#555" />
                            <Ellipse Canvas.Left="46" Canvas.Top="14" Width="8" Height="8" Fill="#D62828" />
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="WheelValueLabel" Text=" 0.00" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Game output" HorizontalAlignment="Center" FontSize="11" Foreground="#444" ToolTip="What the game sees after the sensitivity curve is applied." />
                    <Grid Width="100" Height="100" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,2">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="WheelOutputRotation" Angle="0" />
                        </Grid.RenderTransform>
                        <Canvas Width="100" Height="100">
                            <Ellipse Canvas.Left="4" Canvas.Top="4" Width="92" Height="92" Stroke="#3A2A6B" StrokeThickness="6" Fill="Transparent" />
                            <Line X1="50" Y1="50" X2="50" Y2="10" Stroke="#3A2A6B" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="50" Y1="50" X2="16" Y2="70" Stroke="#3A2A6B" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="50" Y1="50" X2="84" Y2="70" Stroke="#3A2A6B" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="38" Canvas.Top="38" Width="24" Height="24" Fill="#7A3AF7" />
                            <Ellipse Canvas.Left="46" Canvas.Top="14" Width="8" Height="8" Fill="#D62828" />
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="WheelAdjustedLabel" Text=" 0.00" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Throttle bar (0..1) -->
            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Throttle" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="ThrottleBar" Minimum="0" Maximum="1" Value="0" Height="18" Foreground="#2EA84F" />
                <TextBlock Grid.Column="2" x:Name="ThrottleValueLabel" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
            </Grid>

            <!-- Brake bar (0..1) -->
            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Brake" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="BrakeBar" Minimum="0" Maximum="1" Value="0" Height="18" Foreground="#D62828" />
                <TextBlock Grid.Column="2" x:Name="BrakeValueLabel" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
            </Grid>

            <!-- Clutch + Handbrake bars (some wheels expose these) -->
            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Clutch" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="ClutchBar" Minimum="0" Maximum="1" Value="0" Height="14" Foreground="#888" />
                <TextBlock Grid.Column="2" x:Name="ClutchValueLabel" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" />
            </Grid>

            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Handbrake" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="HandbrakeBar" Minimum="0" Maximum="1" Value="0" Height="14" Foreground="#888" />
                <TextBlock Grid.Column="2" x:Name="HandbrakeValueLabel" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" />
            </Grid>

            <!-- Buttons grid -->
            <TextBlock Text="Buttons" Margin="0,10,0,2" Foreground="#444" FontSize="11" />
            <UniformGrid Columns="6" Rows="2" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotDPadUp" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="D↑" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotDPadDown" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="D↓" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotDPadLeft" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="D←" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotDPadRight" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="D→" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotPrevGear" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="←Gr" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotNextGear" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="Gr→" Style="{StaticResource ButtonLabel}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB1" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="Menu" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB2" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="View" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB3" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="A" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB4" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="B" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB5" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="X" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DotB6" Style="{StaticResource ButtonDot}" />
                    <TextBlock Text="Y" Style="{StaticResource ButtonLabel}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
